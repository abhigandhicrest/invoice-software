PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/invoice_editor
CLIENT_URL=http://localhost:5173

# Google Workspace / Gmail SMTP. SMTP_PASS must be an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Required outside production. Use only an address you control.
EMAIL_ALLOWED_RECIPIENTS=
